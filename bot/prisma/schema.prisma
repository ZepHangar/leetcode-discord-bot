generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model UserSetup {
  discordUserId String   @id
  timezone      String?
  sendTime      String?  // "HH:MM", 24h, validated IANA-local
  aiPrompt      String?
  lastSentDate  String?  // "YYYY-MM-DD" in `timezone`; guards duplicate sends
  updatedAt     DateTime @updatedAt
}

model GuildSetup {
  guildId       String   @id
  channelId     String?
  timezone      String?
  sendTime      String?
  aiPrompt      String?  // reserved for future guild-scoped AI personalization; not yet exposed in the UI
  lastSentDate  String?
  updatedAt     DateTime @updatedAt
}
