# Required — Bot token from Discord Developer Portal
DISCORD_TOKEN=

# Required — PostgreSQL connection string
DATABASE_URL=postgresql://zep:zep@localhost:5433/zep?schema=public

# Optional — Set for guild-scoped command registration (instant updates, dev mode)
# Leave empty for global registration (up to 1hr propagation, production)
GUILD_ID=

# Optional — Log level (default: info). Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=
