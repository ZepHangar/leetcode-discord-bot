{
  "name": "leetcode-discord-bot",
  "version": "1.0.0",
  "description": "Production-grade modular Discord bot boilerplate",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts | bunx pino-pretty",
    "start": "bun run src/index.ts",
    "build": "bunx tsc",
    "test": "bun test",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate dev"
  },
  "author": "wbrous",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "discord.js": "^14.18.0",
    "node-cron": "^4.2.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "typescript": "^5.9.3"
  }
}
