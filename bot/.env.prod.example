# Required — Bot token from Discord Developer Portal
DISCORD_TOKEN=

# Required — PostgreSQL credentials (used by both postgres and bot services)
POSTGRES_DB=zep
POSTGRES_USER=zep
POSTGRES_PASSWORD=

# Optional — Guild-scoped command registration (instant updates, dev mode)
# Leave empty for global registration (up to 1hr propagation, production)
GUILD_ID=

# Optional — Log level (default: info). Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Optional — Internal leetcode-api service URL (default: http://leetcode-api:3000)
LEETCODE_API_URL=

# Optional — OpenCode Go API key (https://opencode.ai/docs/go/); leave empty to disable AI personalization
OPENCODE_API_KEY=

# Optional — OpenCode Go model (default: deepseek-v4-flash)
OPENCODE_GO_MODEL=deepseek-v4-flash
