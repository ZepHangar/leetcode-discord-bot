# Required — Bot token from Discord Developer Portal
DISCORD_TOKEN=

# Required — PostgreSQL credentials (used by both postgres and bot services)
POSTGRES_DB=zep
POSTGRES_USER=zep
POSTGRES_PASSWORD=

# Optional — Guild-scoped command registration (instant updates, dev mode)
# Leave empty for global registration (up to 1hr propagation, production)
GUILD_ID=

# Optional — Log level (default: info). Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
